# Live Auction environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Application ---
PORT=3000
NODE_ENV=development
# Base URL used to build links in emails (e.g. password-reset links)
APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/liveauction

# --- Redis (used by the app and BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
# Access token signing (e.g. 15m)
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
# Refresh token signing (e.g. 14d) and cookie lifetime in days
REFRESH_JWT_SECRET=change-me
REFRESH_JWT_EXPIRES_IN=14d
REFRESH_JWT_COOKIE_EXPIRES_IN=14

# --- Email ---
# Sender address for transactional email. SMTP is hardcoded to localhost:1025 for
# development (e.g. Mailpit) — no SMTP credentials are read from the environment.
EMAIL_FROM=Live Auction <noreply@liveauction.local>
